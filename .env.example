# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configuration for NatuAssist
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# VITE_BOT_DIRECT_LINE_SECRET: Secret for Microsoft Bot Framework Web Chat
VITE_BOT_DIRECT_LINE_SECRET=

# Power BI Push URL
POWERBI_PUSH_URL=

# Power BI Dataset Refresh
POWERBI_DATASET_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Microsoft Office 365 / Teams / SharePoint Integration
TEAMS_WEBHOOK_URL=
POWER_AUTOMATE_FLOW_URL=
SHAREPOINT_SITE_URL=https://natulab.sharepoint.com/sites/Controladoria
SHAREPOINT_DOC_LIBRARY=/Auditoria_SAP/2026

# Google Sheets API Key for Secure Backend Proxy
GOOGLE_SHEETS_API_KEY=

# Supabase Multi-Tenant Database
SUPABASE_URL="https://ndurdzchsdneososflbd.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_RfQsXeKoeSvVqaWW9zI4wg_ydbjnNBw"

# Sentry Observability DSN
SENTRY_DSN=

